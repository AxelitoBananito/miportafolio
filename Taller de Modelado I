P0 = 100
r = 0.15
K = 1000
n = 60

tiempos = np.arange(0, n + 1)

#Simulación exponencial
P_exp = P0
población_exp = []

for t in tiempos:
  población_exp.append(P_exp)
  P_exp = P_exp + r * P_exp

#Simulación logística
P_log = P0
población_log = []

for t in tiempos:
  población_exp.append(P_log)
  P_log = P_log + r * P_log * (1 - P_log / K)

#Gráfica comparativa
plt.figure(figsize=(8, 5))

plt.plot(tiempos, población_exp, marker="*", markersize=3, label="Exponencial")
plt.plot(tiempos, población_log, marker="s", markersize=3, label="Logístico")
plt.axhline(y=K, linestyle="--", label="Capacidad de Carga K", color='green')

#plt.xlim(0, 50)
plt.xlabel("Tiempo")
plt.ylabel("Población")
plt.title("Comparación entre crecimiento exponencial y logístico")
plt.legend()
plt.grid()

plt.show()

